{
  "all": true,
  "extension": [".js"],
  "include": ["src/**/*.js"],
  "exclude": ["src/**/*.unit.js", "src/test/**"],
  "require": ["./test/setup.cjs", "@babel/register"],
  "instrument": false,
  "sourceMap": false,
  "check-coverage": true,
  "per-file": true,
  "statements": 95,
  "branches": 95,
  "functions": 95,
  "lines": 95,
  "reporter": ["text", "html", "json", "json-summary"]
}
