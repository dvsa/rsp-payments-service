{
  "name": "awslambda-apigateway-dynamodb-serverless-offline-template",
  "version": "4.0.1",
  "description": "Emulate AWS λ, API Gateway & DynamoDB locally when developing",
  "repository": "<replace>",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "start": "npm run copy-localfiles && npm run compile && npm run parallel",
    "start:local": "npm start",
    "setup:local": "npm run copy-localfiles && cd build && node ../node_modules/serverless/bin/serverless.js dynamodb install",
    "test:coverage": "BABEL_ENV=coverage nyc npm test",
    "test:local-tooling": "node --test test/local-tooling.test.cjs",
    "test:integration:local": "node integration/run.cjs",
    "test:integration:seed": "node integration/run.cjs seed",
    "test:integration:reset": "node integration/run.cjs reset",
    "test:integration:report": "node integration/run.cjs report",
    "test:integration:report:open": "node integration/run.cjs open",
    "test:integration:tooling": "node --test integration/tooling.test.cjs",
    "lint:integration": "eslint --ext .cjs integration",
    "parallel": "./node_modules/.bin/run-p watch offline",
    "presetup": "npm run copy-localfiles",
    "offline": "cd ./build && DYNAMODB_PAYMENTS_TABLE=paymentsTable DYNAMODB_GROUP_PAYMENTS_TABLE=groupPaymentsTable node --env-file=.env ../node_modules/serverless/bin/serverless.js offline start --noAuth",
    "offline-with-auth": "cd ./build && DYNAMODB_PAYMENTS_TABLE=paymentsTable DYNAMODB_GROUP_PAYMENTS_TABLE=groupPaymentsTable node --env-file=.env ../node_modules/serverless/bin/serverless.js offline start",
    "lint": "./node_modules/.bin/eslint src",
    "lint:fix": "./node_modules/.bin/eslint src --fix",
    "watch": "./node_modules/.bin/nodemon --watch src --exec npm run compile",
    "compile": "./node_modules/.bin/babel src -d build",
    "integration": "./node_modules/.bin/run-p --race start wait-on-sls",
    "wait-on-sls": "wait-on --timeout 60000 http-get://localhost:3000/dev/payments && npm run test-i",
    "predeploy": "npm install && npm run prepush",
    "test": "node --no-experimental-detect-module ./node_modules/mocha/bin/mocha.js --require ./test/setup.cjs --require @babel/register \"src/**/*.unit.js\"",
    "test-i": "node --no-experimental-detect-module ./node_modules/mocha/bin/mocha.js --require ./test/integration-safety.cjs --require @babel/register \"src/test/**/*.serviceInt.js\"",
    "copy-localfiles": "npm run copy-sls && npm run copy-mockdata && npm run copy-models && npm run copy-openapi && npm run copy-dotenv",
    "copy-dotenv": "./node_modules/.bin/copyfiles -f .env build",
    "copy-sls": "./node_modules/.bin/copyfiles -f serverless/*.yml build",
    "copy-mockdata": "./node_modules/.bin/copyfiles mock-data/*.json build",
    "copy-models": "./node_modules/.bin/copyfiles -f src/models/*.json build/models",
    "copy-package": "./node_modules/.bin/copyfiles package.json package-lock.json build/",
    "copy-openapi": "./node_modules/.bin/copyfiles openapiReplace.js build/",
    "deploy-AWS": "npm run copy-package && npm run copy-sls && cd ./build && npm install --production && sls deploy",
    "openapireplace": "node openapiReplace.js",
    "start-build": "rm -rf build && npm run copy-localfiles && npm run compile && npm run copy-package && npm run build-node-modules && npm run post-build-cleanup && npm run build-artifact && rm -f build/serverless.yml",
    "build-node-modules": "cd build && npm ci --omit=dev --ignore-scripts --no-audit --no-fund",
    "build-artifact": "cd build && rm -rf artifacts && pwd && sls package --package artifacts",
    "build-openApi": "npm run compile && npm run copy-localfiles && cd build && sls openapi generate -f json && node openapiReplace.js",
    "post-build-cleanup": "rm -rf build/mock-data && rm -f build/package.json && rm -f build/openapiReplace.js && rm -f build/package-lock.json",
    "prepush": "npm run lint && npm test && npm run check-security && npm run check-security-log",
    "check-security": "git secrets --scan",
    "check-security-log": "git log -p | scanrepo",
    "build:prod": "webpack-cli --config webpack.production.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.21.0",
    "@babel/core": "^7.21.0",
    "@babel/preset-env": "^7.20.2",
    "@babel/register": "^7.21.0",
    "archiver": "^5.3.1",
    "babel-loader": "^9.1.2",
    "babel-plugin-istanbul": "^7.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.35.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5",
    "expect": "^29.5.0",
    "fs-extra": "^11.1.0",
    "mocha": "^12.0.3",
    "js-yaml": "^4.3.2",
    "nodemon": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "osls": "^4.4.0",
    "serverless": "npm:osls@^4.4.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-dynamodb": "^0.2.58",
    "serverless-offline": "^14.8.4",
    "serverless-openapi-documenter": "^0.1.7",
    "sinon": "^15.0.1",
    "supertest": "^6.3.3",
    "wait-on": "^7.0.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "@dvsa/rsp-validation": "^4.0.0",
    "@aws-sdk/client-dynamodb": "^3.1165.0",
    "@aws-sdk/client-lambda": "^3.1165.0",
    "@aws-sdk/lib-dynamodb": "^3.1165.0",
    "joi": "^17.8.3",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "serverless": "$serverless",
    "js-yaml@>=4.0.0 <5.0.0": "$js-yaml",
    "serverless-openapi-documenter": {
      "@usebruno/converters": {
        "nanoid": "^3.3.18",
        "@usebruno/schema": {
          "nanoid": "^3.3.18"
        }
      },
      "openapi-to-postmanv2": {
        "yaml": "^1.10.3"
      }
    }
  }
}
